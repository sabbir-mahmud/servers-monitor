# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False

# Who may open the dashboard. Add your LAN IP / hostname / Tailscale name as needed.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# HTTPS is on by default in production (secure cookies, HSTS, redirect to https).
# Only for plain HTTP on this machine or a trusted LAN, set HTTPS=False. Session cookies
# then travel unencrypted, and Admins are warned when the dashboard is opened that way.
HTTPS=False
# Set True only behind a proxy that overwrites X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY_HEADERS=False

# The relay. Agents and this dashboard both dial out here; nothing connects in.
# Upstash: copy the TLS URL (rediss://default:<password>@<name>.upstash.io:6379).
# These admin credentials stay on this machine; each server gets its own limited user.
REDIS_URL=

# SQLite file. In Docker it lives on the `data` volume.
SQLITE_PATH=

# Where servers download the agent from. Pin AGENT_REF to a release tag in production.
AGENT_REPO=sabbir-mahmud/servers-monitor
AGENT_REF=main

MONITOR_METRIC_RETENTION_DAYS=14
# Health checks and webhooks may not reach private/loopback addresses (SSRF guard). Set True
# to monitor services on your LAN. Cloud metadata (169.254.x.x) stays blocked regardless.
MONITOR_ALLOW_PRIVATE_TARGETS=False
# Sign-in throttling (15-minute windows): per account+IP, per account, per IP.
LOGIN_FAILURE_LIMIT=6
LOGIN_ACCOUNT_FAILURE_LIMIT=20
LOGIN_IP_FAILURE_LIMIT=50
ALERT_CPU_PERCENT=90
ALERT_MEMORY_PERCENT=90
ALERT_DISK_PERCENT=90
# Your time zone, for maintenance windows and alert times (e.g. Asia/Dhaka, Europe/London).
TIME_ZONE=UTC
# How people open this dashboard (LAN/Tailscale/HTTPS address). Used in alert messages,
# invitation links and password-reset links. Strongly recommended in production.
DASHBOARD_URL=

# Accounts. People join by invitation; public sign-up (with Admin approval) is off.
ALLOW_SIGNUP=False
INVITATION_DAYS=7
# Seconds a password-reset link stays valid.
PASSWORD_RESET_TIMEOUT=7200

# Email for self-service password resets and invitation emails. Leave EMAIL_HOST empty to
# run mail-free: Admins then create reset/invite links in the Users page and send them.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Server Monitor <noreply@example.com>
