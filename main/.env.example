# Copy to .env and adjust. Every value here has a safe production default except SECRET_KEY.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Postgres in production, e.g. postgres://monitor:secret@db:5432/monitor
DATABASE_URL=
# Redis backs the cache (login throttle), and the Celery broker unless CELERY_BROKER_URL is set.
REDIS_URL=
CELERY_BROKER_URL=
# The URL agents use to reach this server (shown in the install command). Must be https in production.
MONITOR_PUBLIC_URL=http://127.0.0.1:8000
MONITOR_METRIC_RETENTION_DAYS=14
ALERT_CPU_PERCENT=90
ALERT_MEMORY_PERCENT=90
ALERT_DISK_PERCENT=90
# Slack/Discord/Teams incoming-webhook URL for alert notifications.
ALERT_WEBHOOK_URL=
TRUST_PROXY_HEADERS=False
