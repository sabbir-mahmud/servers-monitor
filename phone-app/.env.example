# The Upstash relay this app pairs through. Make the values on the dashboard:
#   cd main && python manage.py phone_app_login
# Copy this file to .env and paste them in. They're built into the app; the login may only
# send pairing requests and read answers. Rebuild after changing them.
EXPO_PUBLIC_REDIS_URL=https://your-db.upstash.io
EXPO_PUBLIC_REDIS_TOKEN=
EXPO_PUBLIC_REDIS_PREFIX=sm
